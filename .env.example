# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (Neon, Netlify DB, Supabase, etc.)
DATABASE_URL=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Plain-text password used to log in to /admin.html
ADMIN_PASSWORD=

# Secret used to sign/verify the admin session cookie (use a long random string)
SECRET=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Your business WhatsApp number in full international format, digits only
# Example: 919876543210  (91 = India country code)
BUSINESS_WHATSAPP=

# ── Branding ──────────────────────────────────────────────────────────────────
BUSINESS_NAME=

# ── Site ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployed site (no trailing slash)
SITE_URL=
