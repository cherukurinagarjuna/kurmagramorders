---
import { CONFIG } from '../config';

interface Props {
  activeNav?: string;
}

const { activeNav = 'home' } = Astro.props;
---

<!-- Announcement & Trust Ribbon -->
<div class="demo-ribbon">
  <div class="container">
    <div class="ribbon-trust-items">
      <span>నంద గోకులం గోశాల ట్రస్ట్ (2018) &bull; శ్రీముఖలింగం సమీపాన అంతకపల్లి 60 ఎకరాల క్షేత్రం</span>
      <span class="ribbon-fssai-tag">
        <svg class="ph-icon" style="width: 14px; height: 14px; color: var(--color-pasupu);"><use href="#ph-seal-check"/></svg>
        FSSAI రిజిస్ట్రేషన్ ప్రాసెస్
      </span>
    </div>
    <div class="ribbon-right">
      <a href="https://kurmagram.com" target="_blank" rel="noopener noreferrer" class="ribbon-link" style="color: var(--color-pasupu); font-weight: 600;" aria-label="kurmagram.com అధికారిక వెబ్‌సైట్ తెరవండి">
        kurmagram.com &nearr;
      </a>
      <a href={`https://wa.me/${CONFIG.whatsapp}`} target="_blank" rel="noopener noreferrer" class="ribbon-link ribbon-wa-link" aria-label={`WhatsApp: +${CONFIG.whatsapp}`}>
        <svg class="ph-icon" style="width: 14px; height: 14px;"><use href="#ph-phone"/></svg>
        +{CONFIG.whatsapp}
      </a>
      <button type="button" id="soundToggleBtn" class="ribbon-sound-btn" aria-label="ధ్వని ఆన్/ఆఫ్ (Toggle Sound)" title="ధ్వని ఆన్/ఆఫ్ (Toggle Sound)">
        <span class="sound-icon" style="display: inline-flex; align-items: center;">
          <svg class="sound-bell-active" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <svg class="sound-bell-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
          </svg>
        </span>
      </button>
      <button type="button" id="ordersHistoryBtn" class="ribbon-link" aria-label="ఆర్డర్ల చరిత్ర చూడండి">
        <svg class="ph-icon" style="width: 13px; height: 13px;"><use href="#ph-receipt"/></svg>
        <span data-i18n="orderHistory">ఆర్డర్ల చరిత్ర</span>
      </button>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href="/" class="brand-logo-link">
      <img src="/assets/images/logo-200.webp" alt="" class="brand-img-logo" width="48" height="48" />
      <div class="brand-text-block">
        <span class="brand-name-te">కూర్మగ్రామము</span>
        <span class="brand-name-en">KURMAGRAM VEDIC VILLAGE</span>
      </div>
    </a>

    <nav class="main-nav" aria-label="ముఖ్య నావిగేషన్">
      <a href="/" class={`nav-link ${activeNav === 'home' ? 'active' : ''}`} data-i18n="navHome">హోమ్</a>
      <a href="/shop" class={`nav-link ${activeNav === 'shop' ? 'active' : ''}`} data-i18n="navShop">ఉత్పత్తులు</a>
      <a href="/about" class={`nav-link ${activeNav === 'about' ? 'active' : ''}`} data-i18n="navAbout">మా గురించి</a>
      <a href="/how-to-order" class={`nav-link ${activeNav === 'how-to-order' ? 'active' : ''}`} data-i18n="navHowToOrder">ఆర్డర్ విధానం</a>
      <a href="/track" class={`nav-link ${activeNav === 'track' ? 'active' : ''}`} data-i18n="navTrack">ట్రాకింగ్</a>
      <a href="/contact" class={`nav-link ${activeNav === 'contact' ? 'active' : ''}`} data-i18n="navContact">సంప్రదించండి</a>
    </nav>

    <div class="header-nav-actions">
      <!-- Language Toggle -->
      <button type="button" id="langToggleBtn" class="nav-btn lang-btn" aria-label="Switch between Telugu and English">
        <span class="lang-text">English</span>
      </button>

      <!-- Cart Drawer Toggle Button -->
      <button type="button" id="headerCartBtn" class="nav-btn cart-toggle-btn" aria-label="మీ బుట్ట తెరవండి">
        <svg class="ph-icon" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M216 40H40a16 16 0 0 0-16 16v144a16 16 0 0 0 16 16h176a16 16 0 0 0 16-16V56a16 16 0 0 0-16-16zm0 160H40V56h176v144zM176 88a48 48 0 0 1-96 0 8 8 0 0 1 16 0 32 32 0 0 0 64 0 8 8 0 0 1 16 0z"/>
        </svg>
        <span data-i18n="cartTitle">మీ బుట్ట</span>
        <span id="cartCountBadge" class="cart-badge-count" style="display: none;">0</span>
      </button>
    </div>
  </div>
</header>
