---
// Orgaxi 4 Core Benefit Pillars & Kalamkari Textile Marquee Band
---

<!-- Orgaxi 4 Benefit Pillars Grid -->
<section class="orgaxi-features-section" aria-label="ముఖ్య ప్రయోజనాలు">
  <div class="container">
    <div class="orgaxi-features-grid">
      <!-- Pillar 1 -->
      <div class="orgaxi-feature-card">
        <div class="feature-icon-bubble">
          <img src="/assets/svg/kalamkari/paddy-stalk.svg" alt="" width="36" height="36" />
        </div>
        <div class="feature-card-content">
          <h3 class="feature-card-title">100% సహజ సేద్యం</h3>
          <p class="feature-card-desc">రసాయనాలు, పురుగుమందులు లేని పవిత్ర జీవామృత భూమి</p>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="orgaxi-feature-card">
        <div class="feature-icon-bubble">
          <img src="/assets/svg/kalamkari/cow-calf.svg" alt="" width="36" height="36" />
        </div>
        <div class="feature-card-content">
          <h3 class="feature-card-title">నంద గోకులం గోశాల</h3>
          <p class="feature-card-desc">అహింసా దేశవాళీ ఆవుల సంరక్షణ & స్వచ్ఛమైన A2 నెయ్యి</p>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="orgaxi-feature-card">
        <div class="feature-icon-bubble">
          <img src="/assets/svg/kalamkari/wooden-ghani.svg" alt="" width="36" height="36" />
        </div>
        <div class="feature-card-content">
          <h3 class="feature-card-title">చెక్క గానుగ నూనెలు</h3>
          <p class="feature-card-desc">సంప్రదాయ కోల్డ్ ప్రెస్డ్ సహజ వెలికితీత విధానం</p>
        </div>
      </div>

      <!-- Pillar 4 -->
      <div class="orgaxi-feature-card">
        <div class="feature-icon-bubble">
          <img src="/assets/svg/kalamkari/kurma-mark.svg" alt="" width="36" height="36" />
        </div>
        <div class="feature-card-content">
          <h3 class="feature-card-title">నవత ట్రాన్స్‌పోర్ట్ డెలివరీ</h3>
          <p class="feature-card-desc">క్షేత్రం నుండి నేరుగా మీ నగరానికి, 0% UPI గేట్‌వే ఫీజు</p>
        </div>
      </div>
    </div>
  </div>
</section>

