---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, CONFIG } from '../config';
---

<Base 
  title="విధానాలు & చట్టబద్ధ నిబంధనలు | కూర్మగ్రామ వేదిక్ విలేజ్" 
  description="కూర్మగ్రామ వేదిక్ విలేజ్ షిప్పింగ్, రిటర్న్స్, గోప్యత, FSSAI మరియు సురక్షిత డైరెక్ట్ UPI చెల్లింపు విధానాల సమగ్ర వివరాలు."
  canonicalPath="/policies"
>
  <Header activeNav="policies" />

  <main id="mainContent" class="editorial-page-main">
    <!-- Editorial Broadsheet Masthead -->
    <header class="broadsheet-masthead">
      <div class="container">
        <!-- Breadcrumbs -->
        <nav class="editorial-breadcrumbs" aria-label="మార్గం">
          <a href="/">హోమ్</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">విధానాలు & నిబంధనలు</span>
        </nav>

        <div class="masthead-crest-row">
          <img src="/assets/svg/kalamkari/vintage-seal.svg" alt="" width="54" height="54" class="kalamkari-crest-svg" />
          <span class="masthead-vintage-tag">చట్టబద్ధమైన పారదర్శకత &bull; TRUST & POLICIES</span>
        </div>

        <h1 class="broadsheet-main-title">
          విధానాలు &bull; చట్టబద్ధ నిబంధనలు
        </h1>
        <p class="broadsheet-main-sub">
          షిప్పింగ్, రీఫండ్, గోప్యత మరియు నాణ్యతా ప్రమాణాల గురించిన సంపూర్ణ పారదర్శక సమాచారం
        </p>

        <!-- Metric Ledger Bar -->
        <div class="editorial-metric-ledger">
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">24–48</span>
            <span class="metric-ledger-label">గంటల్లో ఆర్డర్ డిస్పాచ్</span>
          </div>
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">100%</span>
            <span class="metric-ledger-label">డ్యామేజ్ ఉచిత రీప్లేస్‌మెంట్</span>
          </div>
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">0%</span>
            <span class="metric-ledger-label">డేటా ట్రాకింగ్ లేదా ప్రకటనలు</span>
          </div>
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">స్వచ్ఛం</span>
            <span class="metric-ledger-label">ల్యాబ్ ధృవీకృత గ్రామీణ ఉత్పత్తులు</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Body -->
    <div class="container editorial-body-wrap">

      <!-- Policy 1: Shipping & Delivery -->
      <section class="editorial-policy-block" id="shipping">
        <div class="policy-header-row">
          <span class="policy-num">01</span>
          <div>
            <h2 class="policy-title">షిప్పింగ్ & డెలివరీ విధానం (Shipping & Delivery Policy)</h2>
            <span class="policy-eng-sub">SAFE, SUSTAINABLE & FAST DISPATCH</span>
          </div>
        </div>
        <div class="policy-content-text">
          <p>
            కూర్మగ్రామ వేదిక్ విలేజ్ నుండి మీరు ఆర్డర్ చేసిన ప్రతి ఉత్పత్తి తాజాదనంతో మరియు అత్యున్నత నాణ్యతతో మీ ఇంటికి చేర్చడం మా బాధ్యత.
          </p>
          <ul class="policy-bullets-list">
            <li>
              <strong>డిస్పాచ్ సమయం:</strong> మీ UPI చెల్లింపు UTR ధృవీకరణ పూర్తయిన తర్వాత 24 నుండి 48 గంటల్లోగా మీ పార్శిల్ ఆశ్రమం నుండి డిస్పాచ్ చేయబడుతుంది.
            </li>
            <li>
              <strong>డెలివరీ భాగస్వాములు:</strong> భారతదేశంలో అత్యంత విశ్వసనీయమైన ఇండియా పోస్ట్ స్పీడ్ పోస్ట్ (India Post Speed Post) మరియు DTDC ఎక్స్‌ప్రెస్ ద్వారా పార్శిళ్లను రవాణా చేస్తాము.
            </li>
            <li>
              <strong>డెలివరీ వ్యవధి:</strong>
              <ul>
                <li>ఆంధ్రప్రదేశ్ మరియు తెలంగాణ: 2 నుండి 3 పనిదినాలు.</li>
                <li>దక్షిణ భారతదేశం (కర్ణాటక, తమిళనాడు): 3 నుండి 4 పనిదినాలు.</li>
                <li>మిగిలిన భారతదేశం: 4 నుండి 6 పనిదినాలు.</li>
              </ul>
            </li>
            <li>
              <strong>ట్రాకింగ్ సౌకర్యం:</strong> పార్శిల్ బుక్ చేసిన వెంటనే కొరియర్ ట్రాకింగ్ నంబర్ మరియు ట్రాకింగ్ లింక్ మీ WhatsApp నంబర్‌కు స్వయంచాలకంగా పంపబడుతుంది.
            </li>
            <li>
              <strong>పర్యావరణ అనుకూల ప్యాకింగ్:</strong> ప్లాస్టిక్ వాడకాన్ని కనీస స్థాయికి తగ్గించి, మందపాటి పేపర్ కార్టన్లు, కాటన్ మరియు కొబ్బరి పీచు లేదా జనపనార కుషనింగ్ మాత్రమే ఉపయోగిస్తాము.
            </li>
          </ul>
        </div>
      </section>

      <!-- Handloom Divider -->
      <div class="editorial-vine-break" aria-hidden="true">
        <svg viewBox="0 0 1200 24" width="100%" height="24" fill="none" stroke="currentColor">
          <path d="M0 12 Q 300 0, 600 12 T 1200 12" stroke="var(--color-ittadi)" stroke-width="1.5" stroke-dasharray="6 4"/>
          <circle cx="600" cy="12" r="5" fill="#A62B2B"/>
        </svg>
      </div>

      <!-- Policy 2: Returns & Refunds -->
      <section class="editorial-policy-block" id="refunds">
        <div class="policy-header-row">
          <span class="policy-num">02</span>
          <div>
            <h2 class="policy-title">రిటర్న్స్, రీఫండ్ & మార్పిడి విధానం (Returns & Refund Policy)</h2>
            <span class="policy-eng-sub">100% TRANSIT DAMAGE REPLACEMENT GUARANTEE</span>
          </div>
        </div>
        <div class="policy-content-text">
          <p>
            సహజ వ్యవసాయ ఉత్పత్తులు, గానుగ నూనెలు మరియు ఆయుర్వేద మూలికలు ఆహార పదార్థాల కేటగిరీకి చెందుతాయి. వినియోగదారుల ఆరోగ్య భద్రత దృష్ట్యా తెరిచిన ఆహార ఉత్పత్తులకు సాధారణ రిటర్న్స్ ఉండవు. అయితే:
          </p>
          <ul class="policy-bullets-list">
            <li>
              <strong>రవాణాలో దెబ్బతిన్న వస్తువులకు 100% రీప్లేస్‌మెంట్:</strong> ఒకవేళ నూనె సీసా పగిలినా లేదా పార్శిల్ పాడైపోయి అందినా, పార్శిల్ అందుకున్న 48 గంటల్లోగా బాక్స్ ఫోటో లేదా వీడియోను మా WhatsApp (+{CONFIG.whatsapp}) కు పంపండి. మేము ఏ వాదనలు లేకుండా వెంటనే ఉచితంగా కొత్త పార్శిల్ పంపిస్తాము లేదా మీ నగదును మీ బ్యాంక్ ఖాతాకే రీఫండ్ చేస్తాము.
            </li>
            <li>
              <strong>ఆర్డర్ రద్దు (Cancellation):</strong> మీ పార్శిల్ ఆశ్రమం నుండి డిస్పాచ్ కాకముందు మీరు మాకు కాల్ లేదా WhatsApp చేసి ఆర్డర్ రద్దు చేసుకోవచ్చు. పూర్తి మొత్తం తక్షణమే వాపసు చేయబడుతుంది.
            </li>
          </ul>
        </div>
      </section>

      <!-- Handloom Divider -->
      <div class="editorial-vine-break" aria-hidden="true">
        <svg viewBox="0 0 1200 24" width="100%" height="24" fill="none" stroke="currentColor">
          <path d="M0 12 Q 300 0, 600 12 T 1200 12" stroke="var(--color-ittadi)" stroke-width="1.5" stroke-dasharray="6 4"/>
          <circle cx="600" cy="12" r="5" fill="#A62B2B"/>
        </svg>
      </div>

      <!-- Policy 3: Privacy Policy -->
      <section class="editorial-policy-block" id="privacy">
        <div class="policy-header-row">
          <span class="policy-num">03</span>
          <div>
            <h2 class="policy-title">గోప్యతా విధానం & డేటా భద్రత (Privacy Policy)</h2>
            <span class="policy-eng-sub">ZERO TRACKING & ZERO ADVERTISER DATA LEAKS</span>
          </div>
        </div>
        <div class="policy-content-text">
          <p>
            మా వెబ్‌సైట్ 100% పారదర్శకమైన, ట్రాకింగ్-రహిత సూత్రాలపై నిర్మించబడింది:
          </p>
          <ul class="policy-bullets-list">
            <li>
              <strong>మూడవ పక్షాల ట్రాకర్లు లేవు:</strong> మా వెబ్‌సైట్‌లో ఎలాంటి Facebook Pixel, Google Ads ట్రాకింగ్, లేదా మార్కెటింగ్ విక్రయ స్క్రిప్ట్‌లు లేవు.
            </li>
            <li>
              <strong>డేటా విక్రయించబడదు:</strong> మీ పేరు, ఫోన్ నంబర్, చిరునామా కేవలం మీ పార్శిల్ మీకు చేర్చడానికి మాత్రమే వినియోగించబడతాయి. మేము ఎవరికీ మీ డేటాను విక్రయించము లేదా వాణిజ్య ప్రకటనల కోసం బదిలీ చేయము.
            </li>
            <li>
              <strong>స్థానిక నిల్వ (Local Storage):</strong> మీ కార్ట్ వివరాలు మరియు గత ఆర్డర్ల రికార్డులు కేవలం మీ బ్రౌజర్ లోకల్ స్టోరేజ్‌లో మాత్రమే సురక్షితంగా ఉంటాయి.
            </li>
          </ul>
        </div>
      </section>

      <!-- Handloom Divider -->
      <div class="editorial-vine-break" aria-hidden="true">
        <svg viewBox="0 0 1200 24" width="100%" height="24" fill="none" stroke="currentColor">
          <path d="M0 12 Q 300 0, 600 12 T 1200 12" stroke="var(--color-ittadi)" stroke-width="1.5" stroke-dasharray="6 4"/>
          <circle cx="600" cy="12" r="5" fill="#A62B2B"/>
        </svg>
      </div>

      <!-- Policy 4: FSSAI & Quality Standards -->
      <section class="editorial-policy-block" id="fssai">
        <div class="policy-header-row">
          <span class="policy-num">04</span>
          <div>
            <h2 class="policy-title">చట్టబద్ధమైన & FSSAI వివరణ (FSSAI & Statutory Declaration)</h2>
            <span class="policy-eng-sub">TRADITIONAL VILLAGE INDUSTRY QUALITY ASSURANCE</span>
          </div>
        </div>
        <div class="policy-content-text">
          <p>
            <strong>గ్రామ పరిశ్రమ & సేవా ట్రస్ట్ ప్రాతిపదిక:</strong> కూర్మగ్రామ ఉత్పత్తులు నంద గోకులం గోశాల ట్రస్ట్ ఆధ్వర్యంలో గ్రామీణ స్వయం సమృద్ధి మరియు కుటీర పరిశ్రమ పద్ధతుల్లో సాంప్రదాయక జ్ఞానంతో తయారు చేయబడుతున్నాయి.
          </p>
          <div class="editorial-callout-box">
            <h4 class="callout-heading">{CONFIG.fssai}</h4>
            <p class="callout-para">
              ఆహార భద్రత మరియు ప్రమాణాల నిబంధనల ప్రకారం మా ఉత్పత్తులు నిరంతరం పరిశుభ్రమైన, క్రిమిరహిత వాతావరణంలో సంప్రదాయ యంత్రాల ద్వారా స్వచ్ఛంగా తయారు చేయబడుతున్నాయి. ఎలాంటి కృత్రిమ రసాయనాలు, కృత్రిమ రంగులు, ప్రిజర్వేటివ్‌లు కలపబడవు.
            </p>
          </div>
        </div>
      </section>

      <!-- Handloom Divider -->
      <div class="editorial-vine-break" aria-hidden="true">
        <svg viewBox="0 0 1200 24" width="100%" height="24" fill="none" stroke="currentColor">
          <path d="M0 12 Q 300 0, 600 12 T 1200 12" stroke="var(--color-ittadi)" stroke-width="1.5" stroke-dasharray="6 4"/>
          <circle cx="600" cy="12" r="5" fill="#A62B2B"/>
        </svg>
      </div>

      <!-- Policy 5: Direct UPI Terms -->
      <section class="editorial-policy-block" id="upi-terms">
        <div class="policy-header-row">
          <span class="policy-num">05</span>
          <div>
            <h2 class="policy-title">డైరెక్ట్ UPI చెల్లింపు నిబంధనలు (Peer-to-Peer Settlement Terms)</h2>
            <span class="policy-eng-sub">0% COMMISSION PEER-TO-PEER BANK TRANSFER</span>
          </div>
        </div>
        <div class="policy-content-text">
          <p>
            అన్ని చెల్లింపులు నేరుగా మా ధృవీకృత NPCI VPA <code>{CONFIG.upiId}</code> (నంద గోకులం గోశాల ట్రస్ట్) కు మాత్రమే చేరతాయి. కస్టమర్ అందించిన 12-అంకెల UTR సంఖ్యను మా అకౌంట్స్ డెస్క్ బ్యాంక్ స్టేట్‌మెంట్‌తో ధృవీకరించిన తర్వాతే ఆర్డర్ ప్రాసెస్ ప్రారంభమవుతుంది.
          </p>
        </div>
      </section>

      <!-- CTA Box -->
      <div class="editorial-visit-section" style="margin-top: var(--space-12);">
        <div class="visit-vault-box">
          <h3 class="visit-title">నిబంధనలపై ఏదైనా స్పష్టత కావాలా?</h3>
          <p class="visit-desc">మా సహాయ డెస్క్‌ను సంప్రదించడానికి సంకోచించకండి.</p>
          <div class="visit-actions">
            <a href={`https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent('నమస్తే, నాకు సైట్ నిబంధనల గురించి సమాచారం కావాలి.')}`} target="_blank" rel="noopener noreferrer" class="btn-editorial-primary">
              WhatsApp సంప్రదింపు (+{CONFIG.whatsapp}) &rarr;
            </a>
            <a href="/shop" class="btn-editorial-secondary">ఉత్పత్తుల భాండాగారానికి తిరిగి వెళ్లండి</a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Base>
