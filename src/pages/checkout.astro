---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import OfferStrip from '../components/OfferStrip.astro';
import Footer from '../components/Footer.astro';
import { SITE, CONFIG } from '../config';
---

<Base 
  title={`ఆర్డర్ చెక్అవుట్ & డైరెక్ట్ UPI | ${SITE.name}`} 
  description="కూర్మగ్రామ వేదిక్ విలేజ్ 100% పారదర్శక డైరెక్ట్ UPI చెల్లింపు మరియు WhatsApp ఆర్డర్ ధ్రువీకరణ." 
  canonicalPath="/checkout"
>
  <Header activeNav="shop" />

  <main id="mainContent" class="checkout-page-layout">
    <!-- Broadsheet Masthead Header Strip -->
    <div class="hero-broadsheet-bar">
      <div class="container hero-broadsheet-inner">
        <div class="detail-breadcrumbs">
          <a href="/" class="crumb-link">హోమ్</a>
          <span class="crumb-sep">&bull;</span>
          <a href="/shop" class="crumb-link">ఉత్పత్తుల భాండాగారం</a>
          <span class="crumb-sep">&bull;</span>
          <a href="/cart" class="crumb-link">షాపింగ్ బుట్ట</a>
          <span class="crumb-sep">&bull;</span>
          <span class="crumb-current">డైరెక్ట్ UPI చెక్అవుట్</span>
        </div>
        <span class="masthead-center">DIRECT UPI &bull; 0% GATEWAY FEES</span>
        <span class="masthead-right">నంద గోకులం గోశాల ట్రస్ట్ (ESTD. 2018)</span>
      </div>
    </div>

    <section class="checkout-editorial-section" aria-labelledby="checkoutPageTitle">
      <div class="container">
        <!-- Broadsheet Ledger Header -->
        <div class="catalog-ledger-header">
          <div class="ledger-header-meta">
            <span class="ledger-eyebrow">ధర్మబద్ధ పారదర్శక లావాదేవీల రికార్డు</span>
            <span class="ledger-serial">ORDER LEDGER &bull; FOLIO 108</span>
          </div>
          <h1 id="checkoutPageTitle" class="ledger-title">ఆర్డర్ చెక్అవుట్ & చెల్లింపు</h1>
          <p class="ledger-sub">మధ్యవర్తులు మరియు గేట్‌వే ఫీజులు లేకుండా నేరుగా ట్రస్ట్ ఖాతాకు peer-to-peer UPI చెల్లింపు</p>
          <div class="ledger-masthead-rule" aria-hidden="true"></div>
        </div>

        <div id="checkoutPageRoot" class="checkout-editorial-grid">
          <!-- Populated by JavaScript from window.store -->
          <div style="text-align: center; padding: var(--space-8); grid-column: 1 / -1;">
            <p>ఆర్డర్ వివరాలు లోడ్ అవుతున్నాయి...</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Kalamkari Handloom Vine Divider -->
    <div class="kalamkari-divider-wrap" aria-hidden="true">
      <img src="/assets/svg/kalamkari/vine-divider.svg" alt="" class="kalamkari-vine-svg" width="800" height="24" />
    </div>

    <OfferStrip />
  </main>

  <Footer />
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    function generatePageOrderId() {
      const now = new Date();
      const dateStr = now.toISOString().slice(0, 10).replace(/-/g, '');
      const random = Math.floor(1000 + Math.random() * 9000);
      return `KG-${dateStr}-${random}`;
    }

    function renderDedicatedCheckoutPage() {
      const root = document.getElementById('checkoutPageRoot');
      if (!root || !window.store) return;

      const cart = window.store.cart;
      if (!cart || cart.length === 0) {
        root.innerHTML = `
          <div class="cart-empty-ledger-box" style="grid-column: 1 / -1;">
            <div class="empty-icon-art">
              <img src="/assets/svg/kalamkari/kurma-mark.svg" alt="కూర్మ చిహ్నం" width="56" height="56" />
            </div>
            <h2 class="empty-title">మీ బుట్టలో ఎలాంటి వస్తువులు లేవు</h2>
            <p class="empty-sub">చెక్అవుట్ పూర్తి చేయడానికి దయచేసి ముందుగా ఉత్పత్తుల భాండాగారం నుండి కావలసిన వాటిని ఎంచుకోండి.</p>
            <div class="empty-actions">
              <a href="/shop" class="btn btn-sharp-primary">
                ఉత్పత్తుల భాండాగారం చూడండి &rarr;
              </a>
            </div>
          </div>
        `;
        return;
      }

      // Generate or retrieve current order ID
      if (!window.store.currentOrderId) {
        window.store.currentOrderId = generatePageOrderId();
      }
      const orderId = window.store.currentOrderId;

      let subtotal = 0;
      const orderItems = cart.map((item) => {
        const prod = PRODUCTS.find((p) => p.id === item.productId);
        if (!prod) return null;
        const unit = prod.units[item.unitIndex] || prod.units[0];
        const lineTotal = unit.price * item.qty;
        subtotal += lineTotal;
        return {
          id: prod.id,
          nameTe: prod.te,
          nameEn: prod.en,
          unitLabel: unit.label,
          price: unit.price,
          qty: item.qty,
          lineTotal
        };
      }).filter(Boolean);

      const itemsListHTML = orderItems.map((item, idx) => `
        <li class="checkout-review-item">
          <div class="review-item-main">
            <span class="review-item-idx">${(idx + 1).toString().padStart(2, '0')}.</span>
            <span class="review-item-title">${item.nameTe} (${item.unitLabel}) &times; ${item.qty}</span>
          </div>
          <span class="review-item-total">₹${item.lineTotal}</span>
        </li>
      `).join('');

      // Build NPCI UPI Deep Link
      const upiUrl = `upi://pay?pa=${CONFIG.upiId}&pn=${encodeURIComponent(CONFIG.payeeName)}&am=${subtotal.toFixed(2)}&cu=INR&tn=${orderId}`;

      root.innerHTML = `
        <!-- Left Column: Customer Form & Items Review -->
        <div class="checkout-form-column">
          <div class="checkout-order-stamp-bar">
            <span class="order-id-label">ఆర్డర్ రిజిస్టర్ ID:</span>
            <strong class="order-id-val" id="pageOrderIdDisplay">${orderId}</strong>
            <span class="order-time-stamp">&bull; ${new Date().toLocaleDateString('te-IN')}</span>
          </div>

          <!-- Customer Details Form -->
          <form id="dedicatedCheckoutForm" class="checkout-editorial-form" novalidate>
            <h3 class="form-section-heading">1. డెలివరీ చిరునామా & వివరాలు / CUSTOMER PARTICULARS</h3>
            
            <div class="form-group">
              <label for="pageCustName">పూర్తి పేరు (Full Name) *</label>
              <input 
                type="text" 
                id="pageCustName" 
                class="form-input" 
                placeholder="మీ పూర్తి పేరు నమోదు చేయండి" 
                required 
              />
            </div>

            <div class="form-group">
              <label for="pageCustPhone">WhatsApp / మొబైల్ నంబర్ (Phone Number) *</label>
              <input 
                type="tel" 
                id="pageCustPhone" 
                class="form-input" 
                placeholder="ఉదా: 9876543210 (10 అంకెలు)" 
                pattern="[0-9]{10}"
                required 
              />
              <span class="form-hint">ఈ నంబర్‌కు WhatsApp ద్వారా ఆర్డర్ రసీదు మరియు రవాణా ట్రాకింగ్ పంపబడుతుంది.</span>
            </div>

            <div class="form-group">
              <label for="pageCustAddress">ఇంటి నం., వీధి, గ్రామం/పట్టణం (Address) *</label>
              <textarea 
                id="pageCustAddress" 
                class="form-textarea" 
                placeholder="ఇంటి నంబర్, వీధి, గ్రామం/పట్టణం, మండలం, జిల్లా" 
                rows="2" 
                required
              ></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: var(--space-3);">
              <div class="form-group" style="margin-bottom: 0;">
                <label for="pageCustLandmark">సమీప గుర్తింపు స్థలం / ల్యాండ్‌మార్క్ (Landmark)</label>
                <input 
                  type="text" 
                  id="pageCustLandmark" 
                  class="form-input" 
                  placeholder="ఉదా: రామాలయం / బస్టాండ్ ఎదురుగా" 
                />
              </div>
              <div class="form-group" style="margin-bottom: 0;">
                <label for="pageCustPincode">పిన్‌కోడ్ (Pincode - 6 Digits) *</label>
                <input 
                  type="text" 
                  id="pageCustPincode" 
                  class="form-input" 
                  placeholder="ఉదా: 532001" 
                  maxlength="6"
                  pattern="[0-9]{6}"
                  required 
                />
              </div>
            </div>

            <div class="form-group">
              <label for="pageCustNotes">ప్రత్యేక సూచనలు / Special Notes (ఐచ్ఛికం)</label>
              <input 
                type="text" 
                id="pageCustNotes" 
                class="form-input" 
                placeholder="డెలివరీ సమయం లేదా ప్రత్యేక సూచనలు ఉంటే ఇక్కడ రాయండి" 
              />
            </div>

            <!-- 🚚 Navata Transport Notice & Freight Calculator -->
            <div class="navata-shipping-notice-box" style="background: #FDFBF7; border: 1.5px solid #C9A84C; padding: 1rem 1.2rem; margin-top: 1rem; text-align: left;">
              <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                <span style="font-size: 1.5rem; line-height: 1;">🚚</span>
                <div>
                  <strong style="color: var(--color-kasi); font-size: 0.95rem; display: block; margin-bottom: 0.25rem;">
                    రవాణా ఛార్జీలు అదనం (Shipping Charges are Extra):
                  </strong>
                  <p style="font-size: 0.85rem; color: var(--color-text-muted); margin: 0; line-height: 1.5;">
                    సరుకు రవాణా ఖర్చులు నవత రోడ్ ట్రాన్స్‌పోర్ట్ (Navata Road Transport) టారిఫ్ ప్రకారం ఉంటాయి. మీ ప్రాంతాన్ని మరియు సరుకు బరువును బట్టి డెలివరీ సమయంలో నేరుగా నవత ట్రాన్స్‌పోర్ట్ వారికి రవాణా ఛార్జీలు చెల్లించాలి.
                  </p>
                  <div style="margin-top: 0.6rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                    <a href="https://www.navata.com/freight-cal" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem; font-weight: 700; color: #1B8344; text-decoration: underline; display: inline-flex; align-items: center; gap: 0.3rem;">
                      <span>నవత ఫ్రైట్ కాలిక్యులేటర్ (Navata Freight Calculator) &nearr;</span>
                    </a>
                    <span style="font-size: 0.8rem; color: var(--color-manjistha); font-weight: 700;">మూలం: శ్రీకాకుళం ఆశ్రమం (Srikakulam)</span>
                  </div>
                </div>
              </div>
            </div>
          </form>

          <!-- Order Items Summary Ledger -->
          <div class="checkout-review-box">
            <h4 class="review-box-title">ఆర్డర్ చేసిన ఉత్పత్తుల సమీక్ష / COMMODITIES ORDERED</h4>
            <ul class="checkout-review-list">
              ${itemsListHTML}
            </ul>
            <div class="checkout-review-total">
              <span>మొత్తం చెల్లించవలసినది:</span>
              <span class="review-total-val">₹${subtotal}</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Direct UPI Payment Vault & UTR Capture -->
        <div class="checkout-upi-column">
          <div class="checkout-upi-vault">
            <div class="vault-header">
              <div class="vault-title-group">
                <span class="vault-kicker">0% TRANSACTION FEE &bull; 100% DIRECT</span>
                <h3 class="vault-title">2. డైరెక్ట్ UPI చెల్లింపు & ధ్రువీకరణ</h3>
              </div>
              <img src="/assets/svg/kalamkari/vintage-seal.svg" alt="" width="56" height="56" class="vault-seal-svg" />
            </div>

            <!-- Payee & Amount Box -->
            <div class="vault-amount-box">
              <span class="amount-label">చెల్లించవలసిన మొత్తం:</span>
              <div class="ledger-brass-box vault-grand-brass">
                <span class="price-val">₹${subtotal}</span>
                <span class="unit-tag">/ మొత్తం ఆర్డర్</span>
              </div>
              <div class="payee-account-info">
                <span>ఖాతా పేరు: <strong>${CONFIG.payeeName}</strong></span>
                <span>ట్రస్ట్ UPI ID: <code class="upi-id-code" id="pageUpiIdCode">${CONFIG.upiId}</code></span>
              </div>
              <button type="button" id="pageCopyUpiBtn" class="btn btn-sharp-secondary btn-copy-upi" aria-label="UPI ID కాపీ చేయండి">
                UPI ID కాపీ చేయండి
              </button>
            </div>

            <!-- Secure Razorpay Online Instant Verification Option -->
            <div class="razorpay-pay-box" style="margin-bottom: 1.25rem; background: #FFFFFF; border: 2px solid #229E28; border-radius: 12px; padding: 1.15rem; text-align: center; box-shadow: 0 4px 14px rgba(34,158,40,0.12);">
              <div style="display: flex; align-items: center; justify-content: center; gap: 0.4rem; margin-bottom: 0.35rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#229E28">
                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                </svg>
                <strong style="color: #1B431D; font-size: 0.98rem;">సురక్షిత ఆన్‌లైన్ చెల్లింపు (100% Verified)</strong>
              </div>
              <p style="font-size: 0.8rem; color: #4B5563; margin-bottom: 0.85rem; line-height: 1.45;">
                UPI, Google Pay, PhonePe, కార్డ్స్ & నెట్ బ్యాంకింగ్ ద్వారా తక్షణమే ధ్రువీకరించబడిన చెల్లింపు చేయండి:
              </p>
              <button type="button" id="btnPagePayRazorpay" class="btn btn-sharp-primary" style="width: 100%; justify-content: center; font-size: 0.95rem; font-weight: 800; padding: 0.85rem 1.2rem; background: #229E28; border-color: #1B431D; border-radius: 9999px; box-shadow: 0 4px 12px rgba(34,158,40,0.25); cursor: pointer;">
                <span>🔒 Razorpay తో చెల్లించండి (Pay ₹${subtotal})</span>
              </button>
              <div id="pageRzpStatus" style="display: none; font-size: 0.82rem; margin-top: 0.5rem; font-weight: 700; color: #D97706;"></div>
            </div>

            <!-- Divider -->
            <div style="display: flex; align-items: center; gap: 0.5rem; margin: 1.25rem 0 1rem 0;">
              <hr style="flex: 1; border: none; border-top: 1px dashed #D1D5DB;" />
              <span style="font-size: 0.72rem; font-weight: 700; color: #6B7280; text-transform: uppercase;">లేదా డైరెక్ట్ UPI / QR కోడ్ (0% రుసుము)</span>
              <hr style="flex: 1; border: none; border-top: 1px dashed #D1D5DB;" />
            </div>

            <!-- QR Mode Tabs Switcher -->
            <div class="qr-mode-tabs" role="tablist" aria-label="QR Code రకం ఎంచుకోండి">
              <button type="button" class="qr-mode-tab active" id="tabDynamicQr" role="tab" aria-selected="true">
                డైనమిక్ NPCI QR (₹${subtotal})
              </button>
              <button type="button" class="qr-mode-tab" id="tabOfficialQr" role="tab" aria-selected="false">
                ఆశ్రమ అధికారిక QR (SBI)
              </button>
            </div>

            <!-- NPCI-Compliant Dynamic UPI QR Code View -->
            <div class="vault-qr-wrapper" id="dynamicQrWrapper">
              <span class="qr-step-label">ఫోన్‌పే, గూగుల్‌పే, పేటీఎం లేదా భీమ్ యాప్ ద్వారా స్కాన్ చేయండి:</span>
              <div class="upi-qr-frame" id="pageUpiQrContainer" aria-label="UPI Payment QR Code">
                <!-- SVG QR generated client-side -->
              </div>
              <span class="qr-sub-text">ఆర్డర్ రిఫరెన్స్: <strong>${orderId}</strong> &bull; అమౌంట్: <strong>₹${subtotal}</strong></span>
            </div>

            <!-- Official Ashram Trust QR View (Initially Hidden) -->
            <div class="vault-qr-wrapper" id="officialQrWrapper" style="display: none;">
              <span class="qr-step-label">కూర్మగ్రామ గోశాల ట్రస్ట్ అధికారిక SBI UPI QR కోడ్:</span>
              <div class="official-qr-frame">
                <img src="/assets/images/upi-qr.jpg" alt="కూర్మగ్రామము అధికారిక UPI QR కోడ్" class="official-qr-img" width="220" height="222" />
              </div>
              <span class="official-qr-caption">శ్రీకాకుళం ఆశ్రమంలో ప్రదర్శితమైన అధికారిక QR కోడ్ &bull; UPI: ${CONFIG.upiId}</span>
            </div>

            <!-- Instant Mobile Multi-App Deep Links -->
            <div class="vault-deeplink-row">
              <a href="${upiUrl}" id="pageUpiDeepLinkBtn" class="btn btn-sharp-primary btn-launch-upi" aria-label="UPI యాప్ ద్వారా చెల్లించండి">
                <span>ఏ UPI యాప్ ద్వారానైనా చెల్లించండి (Pay ₹${subtotal}) &nearr;</span>
              </a>
            </div>

            <!-- Step 3: UTR Reference Capture & Screenshot Option -->
            <div class="vault-utr-group">
              <label for="pageUtrInput" class="utr-input-label">
                <strong>3. చెల్లింపు పూర్తయిన తర్వాత 12 అంకెల UTR నంబర్ నమోదు చేయండి:</strong>
              </label>
              <input 
                type="text" 
                id="pageUtrInput" 
                class="form-input utr-input-field" 
                placeholder="12 అంకెల UTR / Ref No (ఉదా: 4218XXXXXXXX)" 
                maxlength="16" 
              />
              <div style="margin-top: 0.6rem; display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" id="pageUtrScreenshotOpt" style="accent-color: var(--color-pasupu); width: 16px; height: 16px; cursor: pointer;" />
                <label for="pageUtrScreenshotOpt" style="font-size: var(--text-caption); color: var(--color-kasi); cursor: pointer; user-select: none;">
                  UTR లభించకపోతే: WhatsApp లో చెల్లింపు స్క్రీన్‌షాట్ జతచేస్తాను
                </label>
              </div>
              <span class="utr-help-text">బ్యాంక్ చెల్లింపు రసీదు లేదా SMS నుండి 12 అంకెల నంబర్‌ను నమోదు చేయవచ్చు లేదా స్క్రీన్‌షాట్ పంపవచ్చు.</span>
            </div>

            <!-- Primary Action: WhatsApp Order Confirmation -->
            <div class="vault-submit-action">
              <button type="button" id="pageSubmitOrderWhatsAppBtn" class="btn btn-sharp-primary btn-whatsapp-confirm">
