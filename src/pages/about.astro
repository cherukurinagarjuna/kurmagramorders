---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, CONFIG } from '../config';
---

<Base 
  title="మా గురించి & ఆశ్రమ జీవన విధానం | కూర్మగ్రామ వేదిక్ విలేజ్" 
  description="శ్రీకాకుళం కిట్టలపాడు సమీపాన గో-ఆధారిత సహజ వ్యవసాయం, నంద గోకులం గోశాల మరియు వైదిక గురుకుల జీవన ప్రస్థానం."
  canonicalPath="/about"
>
  <Header activeNav="about" />

  <main id="mainContent" class="editorial-page-main">
    <!-- Editorial Broadsheet Masthead -->
    <header class="broadsheet-masthead">
      <div class="container">
        <!-- Breadcrumbs -->
        <nav class="editorial-breadcrumbs" aria-label="మార్గం">
          <a href="/">హోమ్</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">మా గురించి & ఆశ్రమ జీవనం</span>
        </nav>

        <div class="masthead-crest-row">
          <img src="/assets/svg/kalamkari/kurma-mark.svg" alt="" width="54" height="54" class="kalamkari-crest-svg" />
          <span class="masthead-vintage-tag">నంద గోకులం గోశాల ట్రస్ట్ &bull; స్థాపన 2018</span>
        </div>

        <h1 class="broadsheet-main-title">
          సరళ జీవనం &bull; ఉన్నత ఆశయం
        </h1>
        <p class="broadsheet-main-sub">
          శ్రీకాకుళం జిల్లా కిట్టలపాడు సమీపాన 60 ఎకరాల ప్రకృతి ఒడిలో గో-ఆధారిత స్వయం సమృద్ధ వైదిక గ్రామం
        </p>

        <!-- Metric Ledger Bar -->
        <div class="editorial-metric-ledger">
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">60</span>
            <span class="metric-ledger-label">ఎకరాల రసాయన రహిత నేల</span>
          </div>
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">2018</span>
            <span class="metric-ledger-label">నుండి నిరంతర అహింసా గోసేవ</span>
          </div>
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">80+</span>
            <span class="metric-ledger-label">ఆశ్రమ సాధకులు & గురుకుల విద్యార్థులు</span>
          </div>
          <div class="metric-ledger-item">
            <span class="ramabhadra-metric">100%</span>
            <span class="metric-ledger-label">దేశవాళీ గో-ఉత్పత్తులు</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Body -->
    <div class="container editorial-body-wrap">
      
      <!-- Section 1: Origins & Living Heritage -->
      <section class="editorial-feature-section">
        <div class="editorial-split-layout">
          <div class="editorial-split-text">
            <div class="section-kicker">
              <span>01 &bull; ఆదర్శం & ప్రస్థానం</span>
            </div>
            <h2 class="editorial-section-title">వైదిక జీవన సంస్కృతికి సజీవ రూపం</h2>
            <p class="editorial-body-para">
              ఆధునిక నగరాల ఉరుకులు పరుగుల యాంత్రిక జీవితం, కాలుష్యం మరియు విషపూరిత ఆహారాల నుండి విముక్తి పొంది, ప్రాచీన భారతదేశపు గ్రామీణ స్వయం సమృద్ధిని (గ్రామ స్వరాజ్యం) పునరుద్ధరించాలనే సంకల్పంతో 2018 లో కూర్మగ్రామ వేదిక్ విలేజ్ ప్రారంభమైంది.
            </p>
            <p class="editorial-body-para">
              శ్రీముఖలింగం సమీపాన మహేంద్రతనయ నదీ పరివాహక ప్రాంతంలోని పచ్చని ప్రకృతి మధ్య, అంతకపల్లి మరియు కిట్టలపాడు గ్రామాల సరిహద్దుల్లో 60 ఎకరాల విస్తీర్ణంలో ఈ ఆశ్రమ క్షేత్రం విలసిల్లుతోంది. ఇక్కడ ప్రతి రోజూ సూర్యోదయానికి ముందే బ్రాహ్మీ ముహూర్తంలో గోపూజ, వేద మంత్రోచ్ఛారణలతో ప్రారంభమవుతుంది.
            </p>
            <div class="editorial-pull-quote">
              <p>"గోవులు, భూమి, సంస్కృతి రక్షించబడితే మానవజాతికి ఎలాంటి రోగాలు, అశాంతి ఉండవు. ప్రకృతితో మమేకమై జీవించడమే అసలైన వైదిక ధర్మం."</p>
            </div>
          </div>
          <div class="editorial-split-visual">
            <div class="editorial-art-frame">
              <img 
                src="/assets/images/farm/optimized/village-life-800w.webp" 
                alt="వరి నాట్లు వేస్తున్న భక్తులు" 
                class="editorial-frame-photo"
                width="800"
                height="600"
                loading="lazy"
              />
              <div class="editorial-frame-caption">
                <strong>వరి నాట్లు వేస్తున్న భక్తులు:</strong> 60 ఎకరాల ప్రకృతి క్షేత్రంలో సంప్రదాయ వరి నాట్లు.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Handloom Divider -->
      <div class="editorial-vine-break" aria-hidden="true">
        <svg viewBox="0 0 1200 24" width="100%" height="24" fill="none" stroke="currentColor">
          <path d="M0 12 Q 300 0, 600 12 T 1200 12" stroke="var(--color-ittadi)" stroke-width="1.5" stroke-dasharray="6 4"/>
          <circle cx="600" cy="12" r="5" fill="#A62B2B"/>
        </svg>
      </div>

      <!-- Section 2: Nanda Gokulam Goshala -->
      <section class="editorial-feature-section">
        <div class="editorial-split-layout reverse-on-desktop">
          <div class="editorial-split-text">
            <div class="section-kicker">
              <span>02 &bull; గోరక్షణ & నంద గోకులం</span>
            </div>
            <h2 class="editorial-section-title">అహింసా గోశాల &bull; గోమాతల ఆనంద నిలయం</h2>
            <p class="editorial-body-para">
              కూర్మగ్రామంలో గోవు కేవలం ఒక జంతువు కాదు, మా కుటుంబంలో అత్యంత పూజనీయమైన సభ్యురాలు. మా గోశాలలో గిర్, కాంక్రీజ్, ఒంగోలు మరియు ఆంధ్రదేశపు పుంగనూరు వంటి దేశవాళీ ఆవులు ప్రేమతో సంరక్షించబడుతున్నాయి.
            </p>
            <ul class="editorial-standards-list">
              <li>
                <strong>దూడలకే ప్రథమ ప్రాధాన్యం:</strong> దూడలు తమ తల్లి పాలు కడుపునిండా తాగిన తర్వాత మాత్రమే మిగిలిన కొద్దిపాటి పాలు ఆశ్రమ ప్రసాదానికి మరియు సంప్రదాయ నెయ్యి తయారీకి ఉపయోగిస్తాము.
              </li>
              <li>
                <strong>ఆజీవన రక్షణ:</strong> వయసు పైబడిన లేదా పాలివ్వలేని ఆవులను ఎన్నడూ విక్రయించము. జీవితాంతం పచ్చిక, దాణా అందిస్తూ గోమాతలుగా పూజిస్తాము.
              </li>
              <li>
                <strong>పంచగవ్య చికిత్స:</strong> ఆవు పాలు, పెరుగు, నెయ్యి, మూత్రం మరియు పేడలతో ఆయుర్వేద పంచగవ్య ఉత్పత్తులు మరియు సహజ సేద్య ఎరువులను మాత్రమే తయారు చేస్తాము.
              </li>
            </ul>
          </div>
          <div class="editorial-split-visual">
            <div class="editorial-art-frame">
              <img 
                src="/assets/images/farm/optimized/desi-cow-portrait-800w.webp" 
                alt="నంద గోకులం దేశవాళీ గోమాత" 
                class="editorial-frame-photo"
                width="800"
                height="600"
                loading="lazy"
              />
              <div class="editorial-frame-caption">
                <strong>నంద గోకులం గిర్ గోమాత:</strong> సహజ పచ్చిక మైదానాల్లో స్వేచ్ఛగా మేసే దేశవాళీ ఆవులు.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Handloom Divider -->
      <div class="editorial-vine-break" aria-hidden="true">
        <svg viewBox="0 0 1200 24" width="100%" height="24" fill="none" stroke="currentColor">
          <path d="M0 12 Q 300 0, 600 12 T 1200 12" stroke="var(--color-ittadi)" stroke-width="1.5" stroke-dasharray="6 4"/>
          <circle cx="600" cy="12" r="5" fill="#A62B2B"/>
        </svg>
      </div>

      <!-- Section 3: Vedic Gurukulam & Education -->
      <section class="editorial-feature-section">
        <div class="editorial-split-layout">
          <div class="editorial-split-text">
            <div class="section-kicker">
              <span>03 &bull; గురుకులం & ఆదర్శ విద్యా విధానం</span>
            </div>
            <h2 class="editorial-section-title">సంస్కృతి, సంస్కారం & స్వావలంబన</h2>
            <p class="editorial-body-para">
              కూర్మగ్రామ గురుకులంలో విద్యార్థులు సాంప్రదాయ గురుకుల పద్ధతిలో విద్యాభ్యాసం చేస్తారు. సంస్కృత వ్యాకరణం, వేద మంత్రోచ్ఛారణ, భగవద్గీత అధ్యయనంతో పాటు సహజ వ్యవసాయం, గో సంరక్షణ మరియు వడ్రంగి, నేత వంటి స్వయం సమృద్ధి వృత్తులను నేర్చుకుంటారు.
            </p>
            <p class="editorial-body-para">
              స్మార్ట్‌ఫోన్లు, డిజిటల్ వ్యసనాలకు దూరంగా, స్వచ్ఛమైన గాలి, ఎండ మరియు శారీరక శ్రమతో దృఢమైన ఆరోగ్యంతో, మానసిక ప్రశాంతతతో భావి భారత సంస్కారవంతమైన పౌరులుగా ఎదుగుతున్నారు.
            </p>
            <div class="editorial-note-box">
              <strong>ధర్మం:</strong> "విద్య కేవలం ఉద్యోగం కోసం కాదు; ఉన్నతమైన శీల నిర్మాణం మరియు లోక కల్యాణం కోసం."
            </div>
          </div>
          <div class="editorial-split-visual">
            <div class="editorial-art-frame">
              <img 
                src="/assets/images/farm/optimized/gurukulam-life-800w.webp" 
                alt="కూర్మగ్రామ గురుకుల విద్యాభ్యాసం" 
                class="editorial-frame-photo"
                width="800"
                height="600"
                loading="lazy"
              />
              <div class="editorial-frame-caption">
                <strong>గురుకుల విద్యార్థులు:</strong> నిరంతర వేదాధ్యయనం, క్రమశిక్షణ మరియు సేవా భావం.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Authentic Photo Gallery -->
      <section class="editorial-gallery-section">
        <div class="gallery-head">
          <span class="gallery-kicker">క్షేత్ర దర్శనం &bull; PHOTOGRAPHIC CHRONICLE</span>
          <h2 class="gallery-title">కూర్మగ్రామ సజీవ దృశ్యాలు</h2>
          <p class="gallery-sub">ఫోటోషూట్ సెట్టింగులు కావు — www.kurmagram.com అధికారిక గ్యాలరీ నుండి సేకరించిన నిజమైన క్షేత్ర చిత్రాలు</p>
        </div>

        <div class="editorial-gallery-grid">
          <figure class="gallery-item">
            <img src="/assets/images/farm/optimized/paddy-fields-800w.webp" alt="వరి చేలలో జీవామృతం" width="800" height="600" loading="lazy" />
            <figcaption>వరి చేలలో సహజ జీవామృతం పోస్తున్న ఆశ్రమ రైతు</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src="/assets/images/farm/optimized/goshala-cows-800w.webp" alt="నంద గోకులం గోవులు" width="800" height="600" loading="lazy" />
            <figcaption>నంద గోకులం గోశాలలో పచ్చిక మేస్తున్న దేశవాళీ గోమాత</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src="/assets/images/farm/optimized/tradition-harvest-800w.webp" alt="సన్యాస కుటీరం" width="800" height="600" loading="lazy" />
            <figcaption>సన్యాస కుటీరం</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src="/assets/images/farm/optimized/community-landscape-800w.webp" alt="చేనేత మగ్గంపై సాధకుడు" width="800" height="600" loading="lazy" />
            <figcaption>సంప్రదాయ చేనేత మగ్గంపై ఖాదీ వస్త్రాలు నేస్తున్న సాధకుడు</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src="/assets/images/farm/optimized/farm-work-800w.webp" alt="గోవు దూడతో సాధకుడు" width="800" height="600" loading="lazy" />
            <figcaption>ఆశ్రమ బాటలో గోవు దూడతో సాధకుడు &bull; ప్రశాంత గ్రామీణ జీవనం</figcaption>
          </figure>
          <figure class="gallery-item">
            <img src="/assets/images/farm/optimized/hero-golden-hour-800w.webp" alt="గ్రామస్తులు మరియు పిల్లలతో సేవ" width="800" height="600" loading="lazy" />
            <figcaption>గ్రామస్తులు మరియు పిల్లలతో ఆధ్యాత్మిక సేవ &bull; ప్రసాద పంపిణీ</figcaption>
          </figure>
        </div>
      </section>

      <!-- Section 5: Visit the Village & Contact Info -->
      <section class="editorial-visit-section">
        <div class="visit-vault-box">
          <h3 class="visit-title">ఆశ్రమాన్ని స్వయంగా సందర్శించండి</h3>
          <p class="visit-desc">
            మీరు కూడా ఈ పవిత్ర వాతావరణాన్ని అనుభవించాలనుకుంటే, గోవులను దర్శించి సేదతీరాలనుకుంటే మా ఆశ్రమానికి సాదర స్వాగతం. ముందస్తు సమాచారం అందించి విచ్చేయగలరు.
          </p>
          <div class="visit-meta-grid">
            <div class="visit-meta-item">
              <strong>దర్శన సమయాలు:</strong>
              <span>ప్రతిరోజూ ఉదయం 6:00 – సాయంత్రం 5:30 (6:00 AM – 5:30 PM)</span>
            </div>
            <div class="visit-meta-item">
              <strong>చిరునామా:</strong>
              <span>అంతకపల్లి గ్రామం, కిట్టలపాడు పోస్ట్, శ్రీకాకుళం జిల్లా – 532428</span>
            </div>
            <div class="visit-meta-item">
              <strong>WhatsApp సమాచారం:</strong>
