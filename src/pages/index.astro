---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import OfferStrip from '../components/OfferStrip.astro';
import FeaturedHarvest from '../components/FeaturedHarvest.astro';
import Catalog from '../components/Catalog.astro';
import Story from '../components/Story.astro';
import Steps from '../components/Steps.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
---

<Base title={SITE.titleHome} description={SITE.description} canonicalPath="/">
  <Header activeNav="home" />
  <main id="mainContent">
    <Hero />
    <OfferStrip />
    <Catalog title="మా సహజ ఉత్పత్తుల భాండాగారం" subtitle="గోశాల మరియు ప్రకృతి క్షేత్రం నుండి నేరుగా మీ ఇంటికి" />
    <Story />
    <Steps />
  </main>
  <Footer />
</Base>
